# ============================================================================
# my-api (:5099) — ตัวอย่าง env สำหรับ production
# ก๊อปเป็น .env หรือใส่เป็น Environment Variables ของ service (Render/Docker)
# ============================================================================

# ── บังคับตั้งบน prod (แอปจะไม่สตาร์ทถ้าไม่มี) ─────────────────────────────
NODE_ENV=production

# ลายเซ็น JWT — สุ่มใหม่เสมอ ห้ามใช้ค่าตัวอย่าง ห้าม commit ค่าจริง
#   สร้างด้วย: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# ต้องมีอย่างน้อยหนึ่งชุด: DATABASE_URL  หรือ  DB_HOST + DB_PASSWORD
DATABASE_URL=
# DB_HOST=
# DB_PORT=5432
# DB_NAME=productiondb
# DB_USER=syntechdb
# DB_PASSWORD=

# ── ต้องตั้งให้ถูกก่อน go-live ────────────────────────────────────────────
# false = ไม่ใส่ข้อมูลตัวอย่าง และไม่สร้าง admin/admin ให้อัตโนมัติ
# (สร้าง admin คนแรกจาก database_schema.sql แล้วเปลี่ยนรหัสทันทีหลังล็อกอิน)
SEED_DEMO=false

# ── ไม่บังคับ (มีค่า default) ─────────────────────────────────────────────
# อายุ token (default 8h) — สั้นลง = ปลอดภัยขึ้นแต่ต้องล็อกอินบ่อยขึ้น
JWT_TTL=8h

# โดเมนที่อนุญาตให้เรียก API ข้าม origin คั่นด้วย comma
# เว้นว่าง = รับเฉพาะ same-origin (ปลอดภัยสุด · ใช้กับ deploy แบบเสิร์ฟหน้าเว็บจาก my-api/public)
CORS_ORIGINS=

# true = ตรวจ SSL certificate ของ DB จริง (เปิดถ้า provider มี CA ให้ · Neon/Render มัก self-signed ต้องปล่อย false)
DB_SSL_STRICT=false

# PORT ปล่อยว่างให้ platform กำหนด (default 5099)
# PORT=5099
